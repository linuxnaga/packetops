# Copy to .env and change every secret. Never commit .env.
PKO_APP_ENV=development
PKO_HTTP_PORT=8080

# Evidence storage: "local" (shared Docker volume) or "s3" (AWS S3 or any S3-compatible store)
PKO_STORAGE_BACKEND=local
# PKO_S3_ENDPOINT_URL=https://s3.example.internal
# PKO_S3_BUCKET=packetops-evidence
# PKO_S3_ACCESS_KEY=
# PKO_S3_SECRET_KEY=

# Authentication: "dev" (seeded users, local only) or "oidc" (production)
PKO_AUTH_MODE=dev
PKO_DEV_JWT_SECRET=change-me-dev-jwt-secret-at-least-32-bytes
# PKO_OIDC_ISSUER=https://login.example.com/realms/packetops
# PKO_OIDC_AUDIENCE=packetops-api
# PKO_OIDC_CLIENT_ID=packetops-web
# PKO_OIDC_JWKS_URL=https://login.example.com/realms/packetops/protocol/openid-connect/certs

# AI copilot: none | anthropic | openai_compatible (local vLLM/Ollama/LM Studio)
PKO_LLM_PROVIDER=none
# PKO_LLM_API_KEY=
# PKO_LLM_MODEL=claude-opus-5-5
# PKO_LLM_BASE_URL=http://ollama:11434/v1

PKO_CORS_ORIGINS=http://localhost:8080
PKO_MAX_UPLOAD_BYTES=2147483648
